<div class="container my-5">
  <div class="text-center mb-5">
    <h1 class="fw-bold text-secondary">Nuestros Profesionales</h1>
    <p class="text-muted">Seleccioná un doctor para iniciar tu consulta médica con asistencia de IA</p>
  </div>

  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% @medicos.each do |medico| %>
      <div class="col">
        <div class="card h-100 border-0 shadow-sm rounded-4 transition-card">
          <div class="card-body p-4 d-flex flex-column">
            
            <div class="d-flex align-items-center mb-3">
              <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold rounded-4" style="width: 50px; height: 50px; font-size: 1.2rem;">
                <%= medico.nombre.first if medico.nombre.present? %>
              </div>
              <div class="ms-3">
                <h5 class="card-title mb-0 fw-semibold text-dark"><%= medico.nombre %></h5>
                <p class="card-text text-primary small mb-0"><%= medico.especialidad %></p>
              </div>
            </div>

            <p class="card-text text-muted small flex-grow-1">
              <%= medico.descripcion.present? ? medico.descripcion : "Profesional de la salud disponible para consultas virtuales y diagnóstico asistido." %>
            </p>

            <div class="mt-4">
              <%= link_to medico_path(medico), class: "btn btn-outline-primary w-100 rounded-3 fw-medium small py-2" do %>
                Consultar Profesional
              <% end %>
            </div>

          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
