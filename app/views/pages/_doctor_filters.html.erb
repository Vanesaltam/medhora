<div class="container my-5">
  <div class="text-center mb-5">
    <h1 class="fw-bold text-secondary">MedHora</h1>
    <p class="text-muted">Seleccioná un profesional para iniciar tu consulta médica asistida por IA</p>
  </div>

  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% @medicos.each do |medico| %>
      <div class="col">
        <%= link_to "/medicos", class: "text-decoration-none" do %>
          <div class="card h-100 border-0 shadow-sm rounded-4 text-dark bg-white">
            <div class="card-body p-4 d-flex flex-column align-items-center text-center">
              
              <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold mb-3" style="width: 80px; height: 80px; font-size: 1.8rem;">
                <%= medico[:nombre].first if medico[:nombre].present? %>
              </div>

              <h5 class="card-title mb-1 fw-semibold"><%= medico[:nombre] %></h5>
              <p class="card-text text-primary small mb-3 fw-medium"><%= medico[:especialidad] %></p>
              
              <p class="card-text text-muted small flex-grow-1">
                <%= medico[:descripcion] %>
              </p>

              <span class="text-primary small fw-semibold mt-3">Consultar Profesional →</span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
